# AgentForge local development template.
# Public-safe example only. Never commit real production credentials.

AGENTFORGE_JAVA_HOME=E:\JDK
DASHSCOPE_API_KEY=replace-me
DASHSCOPE_MODEL=qwen3.8-flash

# MySQL / Redis
MYSQL_HOST=mysql.example.internal
MYSQL_PORT=3306
MYSQL_DATABASE=agentforge
MYSQL_USERNAME=agentforge
MYSQL_PASSWORD=replace-me

REDIS_HOST=redis.example.internal
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0

# Optional external IoT HTTP adapter.
# Demo mode is the safe default. All paths below are synthetic examples.
AGENTFORGE_IOT_DEVICE_STATUS_MODE=demo
AGENTFORGE_IOT_BASE_URL=https://iot.example.internal
AGENTFORGE_IOT_ACCESS_TOKEN=replace-me
AGENTFORGE_IOT_TENANT_ID=1
AGENTFORGE_IOT_DEVICE_DETAIL_PATH=/api/iot/devices/{deviceId}
AGENTFORGE_IOT_DEVICE_DETAILS_PATH=/api/iot/devices/{deviceId}/details
AGENTFORGE_IOT_DEVICE_EVENTS_HISTORY_PATH=/api/iot/devices/{deviceId}/events/history

# Restricted demo write tool. Disabled by default.
AGENTFORGE_IOT_LURE_LAMP_CONTROL_ENABLED=false
AGENTFORGE_IOT_LURE_LAMP_LATEST_PROPERTIES_PATH=/api/iot/devices/{deviceId}/properties/latest
AGENTFORGE_IOT_LURE_LAMP_COMMAND_PATH=/api/iot/device-commands
AGENTFORGE_IOT_LURE_LAMP_REQUEST_TIMEOUT=3s
AGENTFORGE_IOT_LURE_LAMP_VERIFY_ATTEMPTS=10
AGENTFORGE_IOT_LURE_LAMP_VERIFY_INTERVAL=500ms

# Tool Governance / Resilience
AGENTFORGE_TOOL_GOVERNANCE_ENABLED=true
AGENTFORGE_TOOL_GOVERNANCE_BLOCK_REPEATED_NON_RETRYABLE=true
AGENTFORGE_TOOL_GOVERNANCE_MAX_RECORDED_INVOCATIONS=256

# Tool Execution Policy
AGENTFORGE_TOOL_POLICY_ENABLED=true
AGENTFORGE_TOOL_POLICY_CONFIRM_WRITE=true
AGENTFORGE_TOOL_POLICY_CONFIRM_HIGH_RISK_READ=true

# Human-in-the-loop Tool Confirmation
AGENTFORGE_TOOL_CONFIRMATION_TTL=5m

# Model gateway (standalone model-gateway project). When enabled, query rewrite and
# answerability go through it with no direct DashScope fallback. Use a gateway key created with
# allowOverseas=false: knowledge passages must not leave mainland providers.
AGENTFORGE_MODEL_GATEWAY_ENABLED=false
AGENTFORGE_MODEL_GATEWAY_BASE_URL=http://localhost:8090/v1
AGENTFORGE_MODEL_GATEWAY_API_KEY=replace-me
AGENTFORGE_MODEL_GATEWAY_RAG_ROUTE=rag-json
AGENTFORGE_MODEL_GATEWAY_CHAT_ROUTE=standard
# AGENTFORGE_MODEL_PROVIDER=gateway

# Query Rewrite
AGENTFORGE_KNOWLEDGE_QUERY_REWRITE_ENABLED=false
AGENTFORGE_KNOWLEDGE_QUERY_REWRITE_MODEL=qwen3.8-flash
AGENTFORGE_KNOWLEDGE_QUERY_REWRITE_MAX_QUERY_CHARS=512

# Reranking
AGENTFORGE_KNOWLEDGE_RERANK_ENABLED=false
AGENTFORGE_KNOWLEDGE_RERANK_BASE_URL=https://rerank.example.internal/compatible-api/v1
AGENTFORGE_KNOWLEDGE_RERANK_API_KEY=replace-me
AGENTFORGE_KNOWLEDGE_RERANK_MODEL=qwen3-rerank
AGENTFORGE_KNOWLEDGE_RERANK_CANDIDATE_LIMIT=8

# Answerability
AGENTFORGE_KNOWLEDGE_ANSWERABILITY_ENABLED=false
AGENTFORGE_KNOWLEDGE_ANSWERABILITY_MODEL=qwen3.8-flash
AGENTFORGE_KNOWLEDGE_ANSWERABILITY_CANDIDATE_LIMIT=8

# Execution-scoped Retrieval Budget
AGENTFORGE_RETRIEVAL_BUDGET_ENABLED=true
AGENTFORGE_RETRIEVAL_BUDGET_MAX_CALLS_PER_EXECUTION=3

# V0.7 isolated Gold Dataset evaluation
AGENTFORGE_KNOWLEDGE_EVALUATION_ENABLED=false
AGENTFORGE_KNOWLEDGE_EVALUATION_INDEX=agentforge-knowledge-eval-v070
AGENTFORGE_KNOWLEDGE_EVALUATION_DATASET=classpath:knowledge/eval/v070-gold-dataset-v3.json
AGENTFORGE_KNOWLEDGE_EVALUATION_TOP_K=5
AGENTFORGE_KNOWLEDGE_EVALUATION_RRF_K_VALUES=5,20,60,120

# Principal directory. The trusted gateway injects X-AgentForge-User-Id; these decide who that is.
# Unknown users are rejected with 401. Scripts under scripts/ default to the user id dev-staff.
AGENTFORGE_STAFF_USER_IDS=dev-staff
AGENTFORGE_CUSTOMER_USERS=demo-customer-a=cust-a,demo-customer-b=cust-b

# AgentForge local development template
# Never commit real production credentials.

AGENTFORGE_JAVA_HOME=E:\JDK
DASHSCOPE_API_KEY=replace-me
DASHSCOPE_MODEL=qwen3.8-flash

# Existing MySQL / Redis. Configure with scripts/configure-infra.ps1.
MYSQL_HOST=mysql.example.internal
MYSQL_PORT=3306
MYSQL_DATABASE=agentforge
MYSQL_USERNAME=agentforge
MYSQL_PASSWORD=replace-me

REDIS_HOST=redis.example.internal
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
